# IntelliJ plugin build output
editors/intellij/.gradle/
editors/intellij/.idea/
editors/intellij/build/
editors/intellij/.kotlin/
# Gradle's sandbox IDE and its copies of the local platform and IdeaVim
editors/intellij/.intellijPlatform/
toked-optimizer/
token-optimizer/

# Showcase video: runtime files and editor state inside the demo content
# run/* rather than run/ so the exceptions below can be reached at all: git does not
# descend into a directory ignored with a trailing slash.
/showcase/run/*
# Kept: the recordings themselves, the assembly, the dubbed master, and the anchors the
# dub is placed against. Everything else under run/ — the narration beds, the per-cue
# clips, the logs — is regenerated by `dub.py render` and `dub.py master`, and the beds
# are 117 MB each, past GitHub's 100 MB limit.
!/showcase/run/take*.mp4
!/showcase/run/take*.wav
!/showcase/run/showcase-takes.mp4
!/showcase/run/showcase-dubbed.mp4
!/showcase/run/anchors.json
/showcase/demo-java/.idea/
/showcase/demo-java/out/
/showcase/demo-go/vimmode
/showcase/Demo/.obsidian/workspace.json
/showcase/Demo/.obsidian/workspace-mobile.json
/showcase/Demo/.obsidian/plugins/
/showcase/Demo/.trash/
