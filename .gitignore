# onnxruntime drops this in the cwd the first time the kokoro voice runs (it fails to
# persist its telemetry device id and writes a file named after the literal path
# `:memory:`). `dub.py render` produces it; nothing reads it.
:memory:.ses

# Showcase video: runtime files and editor state inside the demo content
# run/* rather than run/ so the exceptions below can be reached at all: git does not
# descend into a directory ignored with a trailing slash.
/showcase/run/*
# Only what the final video cannot be rebuilt without:
#   take<N>.mp4        the recordings. Not reproducible — they come from one session on
#                      the Linux box with the demo content, HUD and editors in a state
#                      that no longer exists.
#   showcase-takes.mp4 the assembly: `dub.py assemble`, a verified concat copy of the takes.
#                      Kept so the deliverable can be rebuilt without re-joining, and so a
#                      stale one is visible in a diff.
#   showcase.mp4       the deliverable.
#   anchors.json       measured per take, and `content_start` is load-bearing.
#   cuts.json          the cut list the deliverable was built from.
#   assembly.json      the takes' and the assembly's hashes; master and tighten refuse to
#                      run when they no longer match the files.
# Everything else under run/ is regenerated by dub.py: the narration beds, the per-cue
# clips, the silent intermediate, the proof and keystrip images, the scratch take<N>.wav
# the piper pass left behind, and the logs.
!/showcase/run/take*.mp4
!/showcase/run/showcase-takes.mp4
!/showcase/run/showcase.mp4
!/showcase/run/anchors.json
!/showcase/run/cuts.json
!/showcase/run/assembly.json
/showcase/demo-java/.idea/
/showcase/demo-java/out/
/showcase/demo-go/vimmode
/showcase/Demo/.obsidian/workspace.json
/showcase/Demo/.obsidian/workspace-mobile.json
/showcase/Demo/.obsidian/plugins/
/showcase/Demo/.trash/
