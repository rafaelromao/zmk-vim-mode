# Kconfig functions split their arguments on commas, so the compatible (which
# contains one) must go through a variable first. Same pattern as ZMK itself.
DT_COMPAT_ZMK_HID_INDICATOR_CODE_LISTENER := zmk,hid-indicator-code-listener

config ZMK_HID_INDICATOR_CODE_LISTENER
    bool "Map multi-bit HID LED indicator codes to layer sets"
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_HID_INDICATOR_CODE_LISTENER))
    depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL
    select ZMK_HID_INDICATORS
    help
      Decode a small integer from a set of HID LED indicator bits sent by the
      host and activate the matching set of layers. Used by zmk-vim-mode to keep
      the keyboard's vim layers in sync with the editor's real mode.

      Enabled automatically when a zmk,hid-indicator-code-listener node is
      present in the keymap. Only built on the central/unibody side: HID output
      reports are received there.

# This module logs through ZMK's own log module (LOG_MODULE_DECLARE(zmk, ...)),
# so its verbosity follows CONFIG_ZMK_LOG_LEVEL. There is deliberately no
# per-module log level: one would be ignored, which is worse than not offering
# it. Set CONFIG_ZMK_LOG_LEVEL_DBG=y to see every decoded code and layer change.
